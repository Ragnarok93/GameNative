From: GameNative BCn optimization work
Subject: [PATCH 1/3] wrapper: recycle BCn descriptor pools per command buffer

The GPU BCn path currently creates and destroys one VkDescriptorPool for every
transcoded region. Reuse chunked pools on the command buffer instead. This
matches the lifetime model already used by push-descriptor emulation: pools are
reset only when the command buffer is legally re-recorded/reset, and destroyed
with the command buffer.

Also bind the BCn compute pipeline once per multi-region copy instead of once
per region. Descriptor sets and push constants remain region-specific.

---
 src/vulkan/wrapper/wrapper_device.c  | 91 ++++++++++++++++++++++++++----------
 src/vulkan/wrapper/wrapper_private.h |  8 ++++
 2 files changed, 75 insertions(+), 24 deletions(-)

diff --git a/src/vulkan/wrapper/wrapper_private.h b/src/vulkan/wrapper/wrapper_private.h
--- a/src/vulkan/wrapper/wrapper_private.h
+++ b/src/vulkan/wrapper/wrapper_private.h
@@
 struct wrapper_push_pool {
    struct wrapper_push_pool *next;
    VkDescriptorPool pool;
    VkDescriptorSetLayout layout;   /* the set layout this pool is sized for */
    uint32_t remaining;             /* sets left before this pool is exhausted */
 };
+
+/* Chunked descriptor pools used by BCn compute transcode. They are owned by a
+ * command buffer so descriptor sets remain valid for the complete GPU lifetime
+ * of that recording. Reset only when the command buffer itself is reset/begun. */
+struct wrapper_bcn_pool {
+   struct wrapper_bcn_pool *next;
+   VkDescriptorPool pool;
+   uint32_t remaining;
+};
 
 struct wrapper_command_buffer {
@@
    VkCommandPool pool;
    struct wrapper_fence *fence;
    VkCommandBuffer dispatch_handle;
    struct wrapper_push_pool *push_pools;   /* emulated push-descriptor pools */
+   struct wrapper_bcn_pool *bcn_pools;     /* BCn compute descriptor pools */
 };

